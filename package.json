{
  "name": "abs-agg",
  "version": "1.1.0",
  "description": "Metadata provider framework for Audiobookshelf",
  "main": "dist/index.js",
  "scripts": {
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:provider": "npm run build && node scripts/test-provider.mjs",
    "build": "node scripts/build.mjs",
    "dev": "tsx src/index.ts",
    "dev:watch": "tsx watch src",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "generate:docs": "tsx src/generateProviderMarkdown.ts",
    "db:migrate": "node --import tsx src/database/migrate.ts"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@hardcover/sdk": "0.1.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.0.0",
    "@opentelemetry/core": "^3.0.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.300.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.300.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-logs": "^3.0.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "axios": "^1.20.0",
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.2.0",
    "dompurify": "^3.4.17",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "jsdom": "^28.1.0",
    "kysely": "^0.29.7",
    "zod": "^4.6.7"
  }
}
