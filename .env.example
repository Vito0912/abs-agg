# Hardcover API Token
# Get your token from https://hardcover.app/account/api
HARDCOVER_TOKEN=
# See https://lazylibrarian.gitlab.io/config_importing/ for the key.
GOODREADS_API_KEY=
# Deezer API Access Token (User OAuth token)
DEEZER_ACCESS_TOKEN=

# Authentication value for Audiobookshelfs custom metadata provider Auth field
# Leave empty to disable authentication
AUTH_TOKEN=

# Comma-separated provider IDs to load, e.g. librivox,hardcover,storytel
# Leave empty to load all available providers
PROVIDER_WHITELIST=

