{
  "id": "storygraph",
  "name": "The StoryGraph",
  "provider": {
    "name": "The StoryGraph",
    "url": "https://app.thestorygraph.com"
  },
  "available": true,
  "description": "Fetches book metadata from The StoryGraph",
  "url": "https://app.thestorygraph.com",
  "parameters": [
    {
      "name": "limit",
      "required": false,
      "validation": {
        "type": "int",
        "min": 1,
        "max": 5
      },
      "description": "Maximum number of results to return",
      "default": 3
    }
  ],
  "returnedFields": [
    "title",
    "author",
    "publisher",
    "publishedYear",
    "description",
    "cover",
    "isbn",
    "language",
    "poweredBy"
  ],
  "comments": []
}
