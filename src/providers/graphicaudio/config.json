{
  "id": "graphicaudio",
  "name": "Graphic Audio",
  "provider": {
    "name": "Graphic Audio",
    "url": "https://www.graphicaudiointernational.net/"
  },
  "available": true,
  "addToAudiobookshelf": false,
  "description": "Fetches metadata from Graphic Audio's catalog. Graphic Audio produces dramatized audiobooks with full cast, music, and sound effects",
  "url": "https://www.graphicaudiointernational.net/",
  "parameters": [
    {
      "name": "limit",
      "required": false,
      "validation": {
        "type": "int",
        "min": 1,
        "max": 20
      },
      "description": "Maximum number of results to return",
      "default": 10
    }
  ],
  "returnedFields": [
    "title",
    "subtitle",
    "author",
    "narrator",
    "description",
    "cover",
    "isbn",
    "asin",
    "genres",
    "series",
    "publishedYear"
  ],
  "comments": [],
  "credits": [
    {
      "url": "https://github.com/binyaminyblatt/graphicaudio_scraper"
    }
  ]
}
